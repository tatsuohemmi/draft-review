---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} | Draft Review</title>
  </head>
  <body>
    <header>
      <nav>
        <a href={base}>Draft Review</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Paragraph comment → GitHub Issue</p>
    </footer>
  </body>
</html>
